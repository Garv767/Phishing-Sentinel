DATABASE_URI = "host=aws-0-us-east-1.pooler.supabase.com " + // The host part of the URI
                "user=postgres.[YOUR-PROJECT-REF] " +         // The user part
                "password=[YOUR-PASSWORD] " +                 // Your database password
                "dbname=postgres " +
                "port=6543 " +                                // Use 6543 for transaction pooling
                "sslmode=require""

JWT_SECRET=some_long_random_string_123456

# Sentinel Configuration
SENTINEL_API_URL=api.sentinellayer.in
SENTINEL_API_KEY=your_sentinel_api_key_here
SENTINEL_WEBHOOK_SECRET=your_sentinel_webhook_secret_here
SENTINEL_SHADOW_MODE=true